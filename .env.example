# Copy to .env (in the folder you run `nc` from, or in %LOCALAPPDATA%\NetworkConnector) to override settings.
# Never put tokens or keys here: they are created automatically and stored in the data folder.
# Every setting in docs/CONFIGURATION.md can be set as NC_<NAME>.

# Data folder (default: %LOCALAPPDATA%\NetworkConnector)
# NC_HOME=D:\NetworkConnectorData

# --- Controller (i7) ---
# Your i7's private LAN address. Never 0.0.0.0. Leave unset to auto-detect.
# NC_BIND_HOST=192.168.1.4
# NC_PORT=8765
# NC_LEASE_SECONDS=60
# NC_DEFAULT_TIMEOUT_S=600
# NC_DEFAULT_MAX_ATTEMPTS=2

# --- Worker (i3) ---
# NC_MAX_CPU_THREADS=3
# NC_MAX_CONCURRENT_JOBS=3
# NC_MAX_MEMORY_MB=2048
# NC_IDLE_TIMEOUT_MINUTES=0
# NC_LOW_PRIORITY=true
