# Copy to infra/.env (git-ignored) and replace every value with fresh random secrets.
# PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })   (64 hex chars)
# sh:         openssl rand -hex 32
NC_PG_PASSWORD=replace-me
NC_ENROLL_SECRET=replace-me-at-least-16-chars
NC_RELAY_TOKEN_KEY=replace-with-64-hex-chars
